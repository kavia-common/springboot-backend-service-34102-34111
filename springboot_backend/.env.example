# Copy this file to .env and adjust values for your environment.
# These variables are read by Spring via application.properties placeholders.

# Comma-separated list of Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer group id for the demo listener
KAFKA_CONSUMER_GROUP_ID=test-group

# Demo topic name used across this project
KAFKA_TEST_TOPIC=test-topic
